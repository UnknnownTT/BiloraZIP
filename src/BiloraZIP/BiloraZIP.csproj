<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BiloraZIP</AssemblyName>
    <RootNamespace>BiloraZIP</RootNamespace>
    <ApplicationIcon>BiloraZIP.ico</ApplicationIcon>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Version>1.0.0-rc.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="BiloraZIP.ico" />
    <Resource Include="Assets\**\*.png" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="0.50.5" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
  </ItemGroup>
</Project>
