<Window x:Class="BiloraZIP.Views.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BiloraZIP — Working" Width="540" Height="385" MinWidth="500" MinHeight="380"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextColor}"
        Closing="Window_Closing">
  <Grid Margin="19">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock x:Name="OperationTitleText" Grid.Row="0" Text="Processing" FontSize="20" FontWeight="Bold"/>
    <TextBlock x:Name="StageText" Grid.Row="1" Text="Preparing…" Foreground="{DynamicResource SecondaryText}" Margin="0,6,0,0"/>
    <TextBlock x:Name="FileText" Grid.Row="2" Text="" TextWrapping="Wrap" MaxHeight="60" Margin="0,6,0,13" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    <ProgressBar x:Name="OverallProgress" Grid.Row="3" Minimum="0" Maximum="100" Height="20"/>
    <Grid Grid.Row="4" Margin="0,7,0,10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="ItemsText" Text="0 files" Foreground="{DynamicResource SecondaryText}"/>
      <TextBlock x:Name="PercentText" Grid.Column="1" Text="0%" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
    </Grid>
    <Border Grid.Row="5" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Padding="12" CornerRadius="6">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Text="Elapsed time" Foreground="{DynamicResource SecondaryText}"/>
        <TextBlock Text="Time remaining (estimate)" Grid.Column="1" Foreground="{DynamicResource SecondaryText}"/>
        <TextBlock x:Name="ElapsedText" Grid.Row="1" Text="00:00:00" FontWeight="SemiBold" Margin="0,4,0,7"/>
        <TextBlock x:Name="RemainingText" Grid.Row="1" Grid.Column="1" Text="Calculating…" FontWeight="SemiBold" Margin="0,4,0,7"/>
        <TextBlock x:Name="BytesText" Grid.Row="2" Grid.ColumnSpan="2" Text="0 B / 0 B" Foreground="{DynamicResource SecondaryText}"/>
      </Grid>
    </Border>
    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="BackgroundButton" Content="Background" Width="105" Margin="0,0,8,0" Click="Background_Click"/>
      <Button x:Name="CancelButton" Content="Cancel" Width="88" Click="Cancel_Click"/>
    </StackPanel>
  </Grid>
</Window>
