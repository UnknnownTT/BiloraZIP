<Window x:Class="BiloraZIP.Views.TextPreviewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="760" Height="550" MinWidth="440" MinHeight="330" WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextColor}">
  <DockPanel Margin="13">
    <TextBlock x:Name="FileNameText" DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,9"/>
    <TextBox x:Name="PreviewText" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="13" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
  </DockPanel>
</Window>
