<Window x:Class="BiloraZIP.Views.SupportWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Support BiloraZIP ❤️" Width="490" Height="310" ResizeMode="NoResize"
 WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextColor}">
 <StackPanel Margin="24">
  <TextBlock Text="Support BiloraZIP ❤️" FontSize="23" FontWeight="Bold" Margin="0,0,0,14"/>
  <TextBlock Text="BiloraZIP is free and open source. If you wish, you can support its continued development with a voluntary donation." TextWrapping="Wrap" Margin="0,0,0,12"/>
  <TextBlock x:Name="LinkStatus" Text="The project owner has not configured a donation link yet." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,16"/>
  <TextBlock Text="Donations are optional. No features are locked, and BiloraZIP does not collect payment details." FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,20"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
   <Button x:Name="DonateButton" Content="Open donation link" Width="170" Margin="0,0,10,0" Click="Donate_Click"/>
   <Button Content="Close" Width="90" IsCancel="True"/>
  </StackPanel>
 </StackPanel>
</Window>
