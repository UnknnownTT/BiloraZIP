<Window x:Class="BiloraZIP.Views.AboutWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="About Bilora" Width="460" Height="390" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
    Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextColor}">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Orientation="Horizontal">
      <Image Source="pack://application:,,,/Assets/BiloraZIP.png" Width="70" Height="70"/>
      <StackPanel Margin="14,9,0,0">
        <TextBlock Text="BiloraZIP" FontSize="26" FontWeight="Bold"/>
        <TextBlock x:Name="VersionLabel" Text="Version" Foreground="{DynamicResource SecondaryText}"/>
      </StackPanel>
    </StackPanel>
    <TextBlock Grid.Row="1" Text="Open-source archive manager for Windows" FontSize="14" Margin="0,16,0,13"/>
    <StackPanel Grid.Row="2" Margin="0,4,0,5">
      <TextBlock Text="Created by Bilguun Munkhzul" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <TextBlock Text="Powered By ChatGPT" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" Margin="0,0,0,10"/>
      <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" Text="Open-source Windows archive manager • Apache License 2.0. ChatGPT assisted the development; archival operations run locally. Not affiliated with WinRAR."/>
    </StackPanel>
    <StackPanel Grid.Row="3">
      <TextBlock Text="Made in Mongolia 🇲🇳" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="0,0,0,12"/>
      <Button Content="Close" Width="100" HorizontalAlignment="Right" IsCancel="True"/>
    </StackPanel>
  </Grid>
</Window>
