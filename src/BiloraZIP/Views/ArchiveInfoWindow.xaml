<Window x:Class="BiloraZIP.Views.ArchiveInfoWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BiloraZIP — Archive information" Width="620" Height="585" MinWidth="520" MinHeight="470" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextColor}">
  <Grid Margin="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
      <Image Source="pack://application:,,,/Assets/BiloraZIP.png" Width="43" Height="43"/>
      <StackPanel Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Margin="0,0,0,10" Text="Archive information" FontSize="21" FontWeight="Bold"/><TextBlock x:Name="ArchiveName" Foreground="{DynamicResource SecondaryText}"/></StackPanel>
    </StackPanel>
    <TabControl Grid.Row="1" Background="{DynamicResource PanelBg}" Foreground="{DynamicResource TextColor}" BorderThickness="0">
      <TabItem Header="Info">
        <DataGrid x:Name="ArchiveDetails" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" CanUserAddRows="False" GridLinesVisibility="None" BorderThickness="0" RowHeaderWidth="0"
                  Background="{DynamicResource PanelBg}" Foreground="{DynamicResource TextColor}"
                  RowBackground="{DynamicResource PanelBg}" AlternatingRowBackground="{DynamicResource ListBg}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Property" Binding="{Binding Field}" Width="190"/>
            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="Options"><TextBlock Margin="16" TextWrapping="Wrap" Text="This is a read-only report. Compression settings depend on the archive format and engine."/></TabItem>
      <TabItem Header="Comment"><TextBlock x:Name="CommentText" Margin="16" TextWrapping="Wrap" Text="Not available"/></TabItem>
      <TabItem Header="SFX"><TextBlock Margin="16" TextWrapping="Wrap" Text="SFX metadata is not exposed by the current archive engine."/></TabItem>
    </TabControl>
    <StackPanel Grid.Row="2" Margin="0,14,0,0" HorizontalAlignment="Right" Orientation="Horizontal"><Button Content="OK" Width="100" IsCancel="True" Click="Close_Click"/></StackPanel>
  </Grid>
</Window>
