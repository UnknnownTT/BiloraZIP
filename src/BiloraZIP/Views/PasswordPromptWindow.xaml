<Window x:Class="BiloraZIP.Views.PasswordPromptWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Encrypted archive — BiloraZIP"
    Width="440" Height="235" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
    Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextColor}">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="Archive password required" FontSize="20" FontWeight="SemiBold"/>
    <TextBlock x:Name="ArchiveLabel" Grid.Row="1" Margin="0,8,0,14" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SecondaryText}"/>
    <PasswordBox x:Name="PasswordInput" Grid.Row="2" Height="34" Padding="8,5" ToolTip="Enter the archive password"/>
    <TextBlock Grid.Row="3" Text="BiloraZIP does not save this password to disk." Margin="0,11,0,0" FontSize="12" Foreground="{DynamicResource SecondaryText}"/>
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Unlock" Width="98" Margin="0,0,9,0" IsDefault="True" Click="Unlock_Click"/>
      <Button Content="Cancel" Width="92" IsCancel="True"/>
    </StackPanel>
  </Grid>
</Window>