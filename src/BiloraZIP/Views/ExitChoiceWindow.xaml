<Window x:Class="BiloraZIP.Views.ExitChoiceWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="BiloraZIP — Exit Options" Width="640" MinWidth="525" MinHeight="300" SizeToContent="Height" ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
 Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextColor}">
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="Exit BiloraZIP" FontSize="21" FontWeight="SemiBold"/>
  <TextBlock Grid.Row="1" Text="Exit completely or keep BiloraZIP in the Windows system tray?" TextWrapping="Wrap" Margin="0,10,0,16" Foreground="{DynamicResource SecondaryText}"/>
  <Border Grid.Row="2" CornerRadius="8" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Background="{DynamicResource PanelBg}" Padding="13">
    <TextBlock Text="You can restore BiloraZIP by double-clicking its tray icon." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}"/>
  </Border>
  <CheckBox x:Name="RememberChoice" Grid.Row="3" Content="Remember this choice" Margin="0,13,0,13" Foreground="{DynamicResource TextColor}"/>
  <WrapPanel Grid.Row="4" HorizontalAlignment="Right" ItemHeight="40">
    <Button Content="Minimize to tray" MinWidth="148" Click="Tray_Click" Margin="0,0,8,0"/>
    <Button Content="Exit BiloraZIP" MinWidth="140" Click="Exit_Click" Margin="0,0,8,0"/>
    <Button Content="Keep working" MinWidth="132" IsCancel="True" Click="Cancel_Click"/>
  </WrapPanel>
 </Grid>
</Window>
