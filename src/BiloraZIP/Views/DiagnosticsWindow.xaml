<Window x:Class="BiloraZIP.Views.DiagnosticsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BiloraZIP — Diagnostic messages" Width="700" Height="400" MinWidth="470" MinHeight="280" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextColor}">
  <Grid Margin="15">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="Diagnostic messages" FontWeight="SemiBold" FontSize="18" Margin="0,0,0,10"/>
    <DataGrid x:Name="IssueList" Grid.Row="1" SelectionChanged="IssueList_SelectionChanged" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False"
              Background="{DynamicResource ListBg}" Foreground="{DynamicResource TextColor}" BorderBrush="{DynamicResource BorderColor}"
              RowBackground="{DynamicResource ListBg}" AlternatingRowBackground="{DynamicResource PanelBg}" GridLinesVisibility="None" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="95"/>
        <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="SizeToCells" MinWidth="480">
          <DataGridTextColumn.ElementStyle>
            <Style TargetType="{x:Type TextBlock}">
              <Setter Property="TextWrapping" Value="NoWrap"/>
              <Setter Property="ToolTip" Value="{Binding Message}"/>
            </Style>
          </DataGridTextColumn.ElementStyle>
        </DataGridTextColumn>
      </DataGrid.Columns>
    </DataGrid>
    <StackPanel Grid.Row="2" Margin="0,10,0,0">
      <TextBlock Text="Selected message — select text with your mouse (Ctrl+C to copy)" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,5"/>
      <TextBox x:Name="SelectedMessageBox" IsReadOnly="True" Height="90" Padding="8" TextWrapping="Wrap"
               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
               Background="{DynamicResource InputBg}" Foreground="{DynamicResource TextColor}" BorderBrush="{DynamicResource BorderColor}"/>
    </StackPanel>
    <TextBlock Grid.Row="3" x:Name="TotalText" Foreground="{DynamicResource SecondaryText}" Margin="0,8"/>
    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Button Content="Close" Margin="0,0,7,0" Click="Close_Click"/>
      <Button x:Name="BreakButton" Grid.Column="1" Content="Break operation" Margin="0,0,7,0" Click="Break_Click"/>
      <Button Grid.Column="2" Content="Copy to clipboard" Click="Copy_Click"/>
    </Grid>
  </Grid>
</Window>
